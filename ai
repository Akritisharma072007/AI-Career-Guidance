# ---------------- MATCH SCORING ----------------
def calculate_match(user_skills, user_interests):
    """
    Transparent rule-based assessment score.
    This is not the ML model's probability or prediction confidence.
    """
    skills = {s.strip().lower() for s in user_skills}
    interests = {s.strip().lower() for s in user_interests}

    results = []

    for career, data in CAREERS.items():
        required = {s.lower() for s in data["skills"]}
        preferred = {s.lower() for s in data["interests"]}

        skill_score = (
            len(skills & required) / len(required) * 100
            if required else 0
        )
        interest_score = (
            len(interests & preferred) / len(preferred) * 100
            if preferred else 0
        )

        # Explicitly defined assessment weighting
        match_score = round(
            0.7 * skill_score + 0.3 * interest_score
        )

        results.append({
            "Career": career,
            "Skill Match": round(skill_score),
            "Interest Match": round(interest_score),
            "Match Score": match_score
        })

    return pd.DataFrame(results).sort_values(
        "Match Score", ascending=False
    )


# ---------------- PDF REPORT ----------------
def create_pdf(assessment, top_career, gaps):
    buffer = BytesIO()
    document = SimpleDocTemplate(buffer, pagesize=A4)
    styles = getSampleStyleSheet()
    story = []

    story.append(Paragraph("Career Compass AI", styles["Title"]))
    story.append(Paragraph("Personal Career Analysis Report", styles["Heading2"]))
    story.append(Spacer(1, 16))

    story.append(Paragraph(
        f"Top matching career: {top_career}",
        styles["Heading2"]
    ))
    story.append(Paragraph(
        CAREERS[top_career]["description"], styles["BodyText"]
    ))
    story.append(Spacer(1, 12))

    story.append(Paragraph("Career Match Scores", styles["Heading2"]))
    for _, row in assessment.iterrows():
        story.append(Paragraph(
            f"{row['Career']}: {row['Match Score']}%",
            styles["BodyText"]
        ))

    story.append(Spacer(1, 12))
    story.append(Paragraph("Skills to Develop", styles["Heading2"]))

    if gaps:
        for skill in gaps:
            story.append(Paragraph(skill, styles["BodyText"]))
    else:
        story.append(Paragraph(
            "No skill gaps identified in this assessment.",
            styles["BodyText"]
        ))

    document.build(story)
    buffer.seek(0)
    return buffer.getvalue()


