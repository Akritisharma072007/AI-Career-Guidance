elif page == "Learning Roadmap":
    st.title("🗺️ Learning Roadmap")

    career = st.selectbox(
        "Choose Your Target Career",
        list(CAREERS.keys()),
        key="roadmap_career"
    )

    steps = CAREERS[career]["roadmap"]

    if career not in st.session_state.completed_steps:
        st.session_state.completed_steps[career] = []

    completed = st.session_state.completed_steps[career]

    st.subheader(f"Roadmap for {career}")

    for step in steps:
        is_done = st.checkbox(
            step,
            value=step in completed,
            key=f"{career}_{step}"
        )

        if is_done and step not in completed:
            completed.append(step)
        elif not is_done and step in completed:
            completed.remove(step)

    progress = len(completed) / len(steps) * 100

    st.progress(int(progress))
    st.metric("Learning Progress", f"{progress:.0f}%")

    progress_df = pd.DataFrame({
        "Status": ["Completed", "Remaining"],
        "Steps": [len(completed), len(steps) - len(completed)]
    })

    fig = px.pie(
        progress_df,
        names="Status",
        values="Steps",
        hole=0.5,
        title="Roadmap Completion"
    )
    fig.update_layout(
        template="plotly_dark",
        paper_bgcolor="#0B0F19",
        font_color="#E5E7EB"
    )
    st.plotly_chart(fig, use_container_width=True)

    st.caption(
        "Progress currently remains in the active Streamlit session. "
        "It is not saved permanently after the session ends."
